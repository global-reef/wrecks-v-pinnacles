# Robust bootstrap contrast between two Classification levels
boot_diff_pair <- function(df, class_a, class_b, B = 5000, seed = 1) {
set.seed(seed)
sub <- df %>% filter(Classification %in% c(class_a, class_b)) %>% droplevels()
# Need both classes present and non-NA
if (n_distinct(na.omit(sub$Classification)) < 2) {
return(tibble(class_a, class_b, l95 = NA_real_, med = NA_real_, u95 = NA_real_))
}
draws <- replicate(B, {
smp <- sub %>% group_by(Classification) %>% sample_frac(replace = TRUE) %>% ungroup()
means <- tapply(smp$mean_total, smp$Classification, mean)
# ensure both names exist; fallback to NA if not
if (!all(c(class_a, class_b) %in% names(means))) return(NA_real_)
as.numeric(means[[class_a]] - means[[class_b]])
})
draws <- draws[!is.na(draws)]
if (!length(draws)) return(tibble(class_a, class_b, l95 = NA_real_, med = NA_real_, u95 = NA_real_))
tibble(
class_a = class_a, class_b = class_b,
l95 = quantile(draws, 0.025),
med = quantile(draws, 0.500),
u95 = quantile(draws, 0.975)
)
}
# Only test pairs that actually exist in the data
present <- site_means %>% distinct(Classification) %>% pull(Classification) %>% as.character()
pairs_to_check <- list(
c("Shipwreck", "Pinnacle"),
c("Shipwreck", "Fringing"),
c("Pinnacle",  "Fringing")
) %>%
purrr::keep(~ all(.x %in% present))
boot_results <- purrr::map_dfr(pairs_to_check, ~ boot_diff_pair(site_means, .x[1], .x[2]))
print(boot_results)
